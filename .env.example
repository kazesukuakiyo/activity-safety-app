# ローカル検証用の設定例。コピーして .env にすると読み込まれます。
APP_SECRET_KEY=change-me-in-production
AUTH_MODE=dev            # dev = 疑似ログイン / entra = Entra ID (未実装)
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data
STAFF_NOTIFY_EMAIL=staff@example.ac.jp

# --- Entra ID を使うときに設定 (AUTH_MODE=entra) ---
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback
