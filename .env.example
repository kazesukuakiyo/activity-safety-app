# ローカル検証用の設定例。コピーして .env にすると読み込まれます。
APP_SECRET_KEY=change-me-in-production
AUTH_MODE=dev            # dev = 疑似ログイン / easyauth = Azure App Service の認証 (Entra ID)
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data
STAFF_NOTIFY_EMAIL=staff@example.ac.jp

# --- Azure (AUTH_MODE=easyauth) のときの役割割り当て。カンマ区切り。載っていない人は学生扱い ---
# STAFF_EMAILS=staff1@example.ac.jp,staff2@example.ac.jp
# MANAGER_EMAILS=kacho@example.ac.jp
# SYSADMIN_EMAILS=sysadmin@example.ac.jp
